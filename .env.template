# ── Supabase ──────────────────────────────────────────────────────────────────
# NOTE: URL and ANON_KEY are NOT needed for eb-core apps.
# packages/logic/src/supabase.ts handles the fallback automatically.
# Only set these if you're using a dedicated/graduated Supabase project.
# EXPO_PUBLIC_SUPABASE_URL=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_SCHEMA=minimal_money

# ── App Environment ───────────────────────────────────────────────────────────
EXPO_PUBLIC_APP_ENV=development   # development | preview | production

# ── Sentry ────────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# ── Apple / EAS Deploy Secrets ────────────────────────────────────────────────
# These live in ~/.zshrc on the developer's machine — DO NOT add them here.
# export APPLE_ID="juanobrach@gmail.com"
# export APPLE_TEAM_ID="C49352LA82"
# export ASC_APP_ID="6756376303"
# export EXPO_TOKEN="..."
