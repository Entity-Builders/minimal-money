{
  "name": "minimal-money",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:dev": "eas build --profile development",
    "build:preview": "eas build --profile preview --platform ios",
    "build:prod": "eas build --profile production --platform ios",
    "build:preview:testflight": "eas build --profile preview-testflight --platform ios --auto-submit",
    "update:preview": "eas update --branch preview --message \"OTA update\"",
    "update:prod": "eas update --branch production --message \"OTA update\"",
    "test": "jest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "gen-types": "mkdir -p src/types && npx supabase gen types typescript --local > src/types/database.types.ts",
    "seed": "node scripts/seed_expenses.js"
  },
  "dependencies": {
    "@eb-packages/logic": "*",
    "@eb-packages/ui": "*",
    "@expo/metro-runtime": "~6.1.2",
    "@gorhom/bottom-sheet": "^5.2.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/slider": "^5.1.1",
    "@react-navigation/native": "^7.1.24",
    "@react-navigation/native-stack": "^7.8.5",
    "@react-navigation/stack": "^7.6.11",
    "@sentry/react-native": "~7.2.0",
    "@supabase/supabase-js": "^2.86.2",
    "date-fns": "^4.1.0",
    "expo": "~54.0.27",
    "expo-application": "~7.0.8",
    "expo-asset": "~12.0.11",
    "expo-blur": "^15.0.8",
    "expo-clipboard": "~8.0.0",
    "expo-constants": "~18.0.11",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-document-picker": "^14.0.8",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-location": "~19.0.8",
    "expo-splash-screen": "~31.0.12",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.15",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "^15.15.1",
    "react-native-url-polyfill": "^1.1.1",
    "react-native-web": "^0.21.0",
    "react-native-worklets": "^0.7.2",
    "rive-react-native": "^9.7.1"
  },
  "private": true,
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.10",
    "@types/react-dom": "^19",
    "@types/react-native-web": "^0",
    "dotenv": "^17.2.3",
    "eslint": "^8",
    "eslint-config-expo": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^30.2.0",
    "prettier": "^3.7.4",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3"
  }
}
