{
  "cli": {
    "version": ">= 16.26.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "corepack": true,
      "env": {
        "SHARP_IGNORE_GLOBAL_LIBVIPS": "1"
      },
      "ios": {
        "image": "sdk-54"
      },
      "android": {
        "image": "sdk-54"
      }
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "development",
        "EXPO_PUBLIC_SUPABASE_SCHEMA": "minimal_money",
        "SENTRY_ORG": "obrach",
        "SENTRY_PROJECT": "minimal-money"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "extends": "base",
      "environment": "preview",
      "distribution": "store",
      "autoIncrement": true,
      "channel": "preview",
      "env": {
        "USE_BASE_BUNDLE_ID": "true",
        "EXPO_PUBLIC_APP_ENV": "preview",
        "EXPO_PUBLIC_SUPABASE_SCHEMA": "minimal_money",
        "SENTRY_ORG": "obrach",
        "SENTRY_PROJECT": "minimal-money",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_SENTRY_DSN": "https://bb045b86910322a8033d4a228aa1c238@o1031007.ingest.us.sentry.io/4510501735628800"
      }
    },
    "production": {
      "extends": "base",
      "distribution": "store",
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "production",
        "EXPO_PUBLIC_SUPABASE_SCHEMA": "minimal_money",
        "SENTRY_ORG": "obrach",
        "SENTRY_PROJECT": "minimal-money",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "EXPO_PUBLIC_SENTRY_DSN": "https://bb045b86910322a8033d4a228aa1c238@o1031007.ingest.us.sentry.io/4510501735628800"
      }
    }
  },
  "submit": {
    "production": {},
    "preview": {
      "ios": {
        "appleId": "juanobrach@gmail.com",
        "ascAppId": "6756376303",
        "appleTeamId": "C49352LA82"
      }
    }
  }
}
